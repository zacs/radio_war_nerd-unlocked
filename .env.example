# ---------------------------------------------------------------- Patreon --
# No login is used or needed: only publicly unlocked posts are visible.
PATREON_VANITY=radiowarnerd
# Optional. Set this if the campaign id cannot be scraped from the page.
# PATREON_CAMPAIGN_ID=
# How far back to walk the post archive on each run.
PATREON_MAX_POSTS=500
# Cap the work done by a single run (0 = no cap). Useful for the first backfill.
MAX_NEW_EPISODES_PER_RUN=0
# Case-insensitive regex; posts whose title matches are skipped. The default
# drops the short "FREE PREVIEW" teaser clips of otherwise paywalled episodes,
# while keeping full episodes such as "FREE REPOST ... [UNLOCKED]".
# Set to an empty value to mirror every unlocked post.
EXCLUDE_TITLE_PATTERN=\bfree\s+preview\b|^\s*preview\b

# ----------------------------------------------------- Cloudflare R2 (S3) --
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=radio-war-nerd
# Public hostname serving the bucket: an r2.dev subdomain or your own domain.
PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# Optional: only if you use a non-default S3 endpoint.
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Optional: store everything under a folder inside the bucket.
# R2_PREFIX=rwn
FEED_KEY=feed.xml
STATE_KEY=state.json

# ------------------------------------------------------------------- Feed --
FEED_TITLE=Radio War Nerd (Unlocked)
FEED_DESCRIPTION=Publicly unlocked episodes of Radio War Nerd, collected from Patreon.
FEED_LINK=https://www.patreon.com/radiowarnerd
FEED_AUTHOR=Radio War Nerd
FEED_OWNER_NAME=Radio War Nerd
FEED_OWNER_EMAIL=you@example.com
FEED_LANGUAGE=en-us
FEED_CATEGORIES=News,Politics
FEED_EXPLICIT=true
# Optional channel art. Defaults to the newest episode's art.
# FEED_IMAGE_URL=
# Keep only the N newest items in the feed (0 = all).
FEED_MAX_ITEMS=0

# --------------------------------------------------------------- Schedule --
# Standard 5-field cron expression, evaluated in UTC.
CRON_SCHEDULE=17 */6 * * *
# Set to true to run a single pass and exit (for host cron / Kubernetes CronJob).
RUN_ONCE=false
DRY_RUN=false
LOG_LEVEL=INFO
DOWNLOAD_ART=true
